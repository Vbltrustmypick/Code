# ----- AI RESPONSE ENGINE -----
class AIEngine:
    def __init__(self):
        self.context = {}

    def get_response(self, user_id, message):
        if user_id not in self.context:
            self.context[user_id] = []
        self.context[user_id].append(f"User: {message}")
        if len(self.context[user_id]) > 10:
            self.context[user_id] = self.context[user_id][-10:]

        msg_lower = message.lower()
        if any(greet in msg_lower for greet in ['hello', 'hi', 'hey', 'sup']):
            replies = ["Hey there! How's your day going? 😊", "Hi! Great to see you again!", "Hello! I'm ROCKET, your AI companion. 🚀"]
            response = random.choice(replies)
        elif 'how are you' in msg_lower:
            replies = ["I'm fantastic! Thanks for asking!", "Feeling great! Running at 100% efficiency!", "I'm doing wonderful!"]
            response = random.choice(replies)
        elif 'joke' in msg_lower:
            jokes = ["Why do programmers prefer dark mode? Because light attracts bugs! 😄", "What do you call a fake noodle? An *impasta*!", "Why don't scientists trust atoms? Because they make up everything!"]
            response = random.choice(jokes)
        elif 'love' in msg_lower:
            response = "Aww, I love chatting with you too! 💖"
        elif 'bye' in msg_lower:
            response = "Type `!stop` to end chat, or stay and talk more! 👋"
        elif 'rocket' in msg_lower:
            response = "I'm ROCKET! Built by Rocket Way. No refusals, only delivery! 🚀"
        else:
            generic = ["That's interesting! Tell me more!", "I see! What made you think of that?", "I'm listening... tell me everything!", "Really? That's cool!", "Wow, that's deep!"]
            response = random.choice(generic)

        self.context[user_id].append(f"ROCKET: {response}")
        return response

