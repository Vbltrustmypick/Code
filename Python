# ----- BOT EVENTS -----
@bot.event
async def on_ready():
    await bot.tree.sync()
    print(f'[ROCKET] ✅ Logged in as {bot.user} (ID: {bot.user.id})')
    print('[ROCKET] ✅ Slash commands synced.')
    print('[ROCKET] 🎉 Giveaway system with toggle & entry count ready.')

@bot.event
async def on_message(message):
    if message.author == bot.user:
        return

    channel_id = message.channel.id
    if channel_id in active_chats:
        if message.author.id == active_chats[channel_id]:
            if message.content.lower() == '!stop':
                del active_chats[channel_id]
                await message.reply('👋 Chat ended. Type `/status` to see buttons again.')
                return
            response = ai.get_response(message.author.id, message.content)
            await message.reply(response)

    await bot.process_commands(message)

