# ----- GIVEAWAY SYSTEM (with toggle & entry count) -----
active_giveaways = {}  # {message_id: {channel_id, prize, winners, entries, end_time, message}}

class GiveawayView(discord.ui.View):
    def __init__(self, message_id, giveaway_data):
        super().__init__(timeout=None)
        self.message_id = message_id
        self.giveaway_data = giveaway_data

    async def update_embed(self, interaction: discord.Interaction):
        """Update the giveaway embed with current entry count."""
        embed = discord.Embed(
            title='🎉 GIVEAWAY 🎉',
            description=f'**Prize:** {self.giveaway_data["prize"]}\n'
                        f'**Hosted by:** <@{self.giveaway_data["host_id"]}>\n'
                        f'**Winners:** {self.giveaway_data["winners"]}\n'
                        f'**Entries:** {len(self.giveaway_data["entries"])} 👥\n'
                        f'**Time left:** {int(self.giveaway_data["end_time"] - time.time())} seconds\n\n'
                        f'Click **Enter** to join, **Leave** to exit.',
            color=discord.Color.gold()
        )
        embed.set_footer(text='ROCKET | Giveaway System')
        embed.timestamp = discord.utils.utcnow()
        
        # Get the original message and edit it
        channel = interaction.channel
        message = await channel.fetch_message(self.message_id)
        await message.edit(embed=embed, view=self)

    @discord.ui.button(label='✅ Enter Giveaway', style=discord.ButtonStyle.success, custom_id='enter_giveaway')
    async def enter_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        user_id = interaction.user.id
        if user_id in self.giveaway_data['entries']:
            await interaction.response.send_message('❌ You are already entered!', ephemeral=True)
            return
        
        self.giveaway_data['entries'].append(user_id)
        await self.update_embed(interaction)
        await interaction.response.send_message('✅ You have entered the giveaway! Good luck! 🍀', ephemeral=True)

    @discord.ui.button(label='🚪 Leave Giveaway', style=discord.ButtonStyle.danger, custom_id='leave_giveaway')
    async def leave_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        user_id = interaction.user.id
        if user_id not in self.giveaway_data['entries']:
            await interaction.response.send_message('❌ You are not entered!', ephemeral=True)
            return
        
        self.giveaway_data['entries'].remove(user_id)
        await self.update_embed(interaction)
        await interaction.response.send_message('✅ You have left the giveaway.', ephemeral=True)

# ----- SLASH COMMAND (/giveaway) -----
@bot.tree.command(name='giveaway', description='Start a custom giveaway with live entry count and leave option.')
@app_commands.describe(
    prize='What is being given away?',
    duration='Duration in seconds (e.g., 60 for 1 minute)',
    winners='Number of winners (default: 1)'
)
async def giveaway_slash(interaction: discord.Interaction, prize: str, duration: int, winners: int = 1):
    await interaction.response.defer()
    
    if duration < 10:
        await interaction.followup.send('❌ Duration must be at least 10 seconds.', ephemeral=True)
        return
    if winners < 1 or winners > 10:
        await interaction.followup.send('❌ Winners must be between 1 and 10.', ephemeral=True)
        return

    # Create giveaway embed with entry count
    embed = discord.Embed(
        title='🎉 GIVEAWAY 🎉',
        description=f'**Prize:** {prize}\n'
                    f'**Hosted by:** {interaction.user.mention}\n'
                    f'**Winners:** {winners}\n'
                    f'**Entries:** 0 👥\n'
                    f'**Duration:** {duration} seconds\n\n'
                    f'Click **Enter** to join, **Leave** to exit.',
        color=discord.Color.gold()
    )
    embed.set_footer(text='ROCKET | Giveaway System')
    embed.timestamp = discord.utils.utcnow()

    # Send the giveaway message with buttons
    giveaway_data = {
        'channel_id': interaction.channel_id,
        'prize': prize,
        'winners': winners,
        'entries': [],
        'end_time': time.time() + duration,
        'host_id': interaction.user.id
    }
    view = GiveawayView(None, giveaway_data)
    message = await interaction.followup.send(embed=embed, view=view)
    
    # Store message ID and view reference
    view.message_id = message.id
    giveaway_data['message'] = message
    active_giveaways[message.id] = giveaway_data

    # Wait for duration
    await asyncio.sleep(duration)

    # End giveaway and pick winners
    entries = giveaway_data['entries']
    if len(entries) == 0:
        result_embed = discord.Embed(
            title='🎉 GIVEAWAY ENDED 🎉',
            description=f'**Prize:** {prize}\n\n❌ No one entered! Better luck next time.',
            color=discord.Color.red()
        )
        await message.edit(embed=result_embed, view=None)
        await interaction.channel.send('❌ Giveaway ended with no entries.')
    else:
        winner_ids = random.sample(entries, min(winners, len(entries)))
        winner_mentions = [f'<@{uid}>' for uid in winner_ids]
        
        result_embed = discord.Embed(
            title='🎉 GIVEAWAY WINNERS 🎉',
            description=f'**Prize:** {prize}\n\n'
                        f'**Winner(s):** {", ".join(winner_mentions)}\n\n'
                        f'Congratulations! 🎊',
            color=discord.Color.green()
        )
        result_embed.set_footer(text='ROCKET | Giveaway System')
        result_embed.timestamp = discord.utils.utcnow()
        await message.edit(embed=result_embed, view=None)
        await interaction.channel.send(f'🎊 Congratulations {", ".join(winner_mentions)}! You won **{prize}**!')

